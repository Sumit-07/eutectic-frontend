# Next.js build output and the type shim it regenerates on every build/dev run.
# The repo-root .gitignore covers node_modules/, dist/, .turbo/ and logs.
.next/
next-env.d.ts
*.tsbuildinfo

# M0-FE-07 — Storybook is dev-only tooling; its built catalogue and caches
# never ship and never enter the app bundle.
storybook-static/
.storybook-out/
*.storybook.log

# M0-FE-10 — Playwright run artefacts (traces, diffs, actual-vs-expected PNGs,
# the HTML reporter). The BASELINE screenshots under
# e2e/*.spec.ts-snapshots/ are the opposite of this: they are the expectation,
# they are reviewed by eye, and they are committed.
test-results/
playwright-report/
blob-report/
